{
  "schemaVersion": 1,
  "id": "dead-heads",
  "version": "${version}",
  "name": "Dead Heads",
  "description": "Places a player head containing death drops where players die",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/dead-heads",
    "issues": "https://github.com/fatlard1993/dead-heads/issues"
  },
  "license": "MIT",
  "icon": "assets/dead-heads/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.dead_heads.Main"
    ]
  },
  "mixins": [
    "dead-heads.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25"
  },
  "suggests": {
    "map-plus-plus": "*",
    "chest-utils": "*",
    "pandorical": "*"
  }
}
